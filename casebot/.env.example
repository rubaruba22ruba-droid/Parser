DAILY_CHANNEL=        # @канал для задания «подпишись» в Daily Case (бот — админ канала); пусто = без проверки
TWA_RETURN_URL=       # https://t.me/<bot>/<app> — возврат в Mini App после оплаты в кошельке
PUBLIC_URL=           # публичный https-адрес (для баннера в приветствии бота), по умолчанию = WEBAPP_URL
